{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "article_input",
  "title": "Article Input — Step 1",
  "description": "Input artikel referensi yang dimasukkan editor di Step 1",
  "type": "object",
  "required": ["title", "body", "sources"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300,
      "description": "Judul artikel referensi"
    },
    "body": {
      "type": "string",
      "minLength": 100,
      "description": "Isi lengkap artikel referensi"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "Daftar sumber artikel",
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "URL sumber"
          },
          "label": {
            "type": "string",
            "description": "Nama/label sumber (opsional)"
          },
          "accessed_at": {
            "type": "string",
            "format": "date-time",
            "description": "Tanggal akses sumber"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Metadata tambahan artikel",
      "properties": {
        "topic": {
          "type": "string",
          "description": "Topik/kategori artikel (misal: Politik, Ekonomi, Teknologi)"
        },
        "language": {
          "type": "string",
          "default": "id",
          "description": "Bahasa artikel (ISO 639-1)"
        },
        "publication_date": {
          "type": "string",
          "format": "date",
          "description": "Tanggal publikasi artikel referensi"
        },
        "author": {
          "type": "string",
          "description": "Penulis artikel referensi (jika ada)"
        },
        "notes": {
          "type": "string",
          "description": "Catatan tambahan dari editor"
        }
      }
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu editor submit artikel"
    }
  },
  "additionalProperties": false
}
