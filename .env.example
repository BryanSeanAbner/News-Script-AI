# ============================================================
# NewsScript AI — Environment Variables Template
# ============================================================
# BACKEND : Copy file ini ke backend/.env dan isi nilai yang diperlukan
# FRONTEND: Copy file ini ke frontend/.env.local dan isi VITE_* vars
# JANGAN commit .env / .env.local ke git — hanya .env.example yang di-commit
# ============================================================

# ------------------------------------------------------------
# AI PROVIDERS — REQUIRED
# ------------------------------------------------------------

# Google Gemini API Key
# Digunakan untuk: Step 2 (Fact Extraction), Step 3 (Gap Analysis),
#                  Step 4 (Angle Mapping), Step 6 (Title Generation),
#                  Step 8 (Grounding Check)
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Grok API Key (xAI)
# Digunakan untuk: Step 7 (Draft Generation) SAJA
# Dapatkan di: https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here

# ------------------------------------------------------------
# AI MODEL CONFIGURATION
# ------------------------------------------------------------

# Model Gemini untuk step murah (2,3,4,6,8)
# Options: gemini-3.6-flash, gemini-3.5-flash, gemini-flash-latest
GEMINI_MODEL=gemini-3.6-flash

# Model Grok untuk draft generation (step 7)
# Options: grok-3, grok-3-mini, grok-2
GROK_MODEL=grok-3

# Grok API Base URL (default xAI endpoint)
GROK_BASE_URL=https://api.x.ai/v1

# ------------------------------------------------------------
# FRONTEND CONFIGURATION (prefix VITE_ — dibaca oleh Vite)
# Salin variabel ini ke frontend/.env.local
# ------------------------------------------------------------

# URL backend API — diakses oleh React frontend
VITE_API_BASE_URL=http://localhost:8000

# Nama aplikasi yang ditampilkan di UI
VITE_APP_NAME=NewsScript AI

# ------------------------------------------------------------
# APP CONFIGURATION (Backend)
# ------------------------------------------------------------

# Nama aplikasi (server-side)
APP_NAME=NewsScript AI

# Backend server port
BACKEND_PORT=8000

# Frontend URL untuk CORS whitelist (development)
FRONTEND_URL=http://localhost:5173

# Frontend URL untuk CORS whitelist (production — uncomment jika deploy)
# FRONTEND_URL_PROD=https://your-production-domain.com

# Environment mode: development | production
APP_ENV=development

# ------------------------------------------------------------
# PIPELINE CONFIGURATION
# ------------------------------------------------------------

# Jumlah gap yang dihasilkan di Step 3 (default: 3)
PIPELINE_GAP_COUNT=3

# Jumlah angle yang dihasilkan di Step 4 (default: 3)
PIPELINE_ANGLE_COUNT=3

# Jumlah opsi title di Step 6 (default: 5)
PIPELINE_TITLE_COUNT=5

# Grounding score minimum untuk lanjut ke Step 9 (0.0 - 1.0)
GROUNDING_THRESHOLD_PASS=0.85

# Grounding score minimum dengan WARNING (0.0 - 1.0)
GROUNDING_THRESHOLD_WARN=0.70

# Max retry untuk Gemini API calls
GEMINI_MAX_RETRY=3

# Max retry untuk Grok API calls
GROK_MAX_RETRY=2

# Retry delay base dalam detik (exponential backoff)
RETRY_DELAY_BASE=1.0

# ------------------------------------------------------------
# STORAGE CONFIGURATION
# ------------------------------------------------------------

# Path ke folder penyimpanan session (relatif dari backend/)
DATA_SESSIONS_PATH=data/sessions

# Path ke folder penyimpanan artikel yang dipublish (relatif dari backend/)
DATA_PUBLISHED_PATH=data/published

# Session TTL dalam jam (sesi tidak aktif akan diarsipkan)
# 0 = tidak ada TTL (session tersimpan selamanya)
SESSION_TTL_HOURS=168

# Maksimum jumlah session yang disimpan (0 = tidak ada batas)
SESSION_MAX_COUNT=0

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log ke file? true | false
LOG_TO_FILE=false

# Path file log (relatif dari backend/, hanya jika LOG_TO_FILE=true)
LOG_FILE_PATH=logs/app.log

# ------------------------------------------------------------
# OPTIONAL: Advanced AI Configuration
# ------------------------------------------------------------

# Gemini safety settings (BLOCK_NONE / BLOCK_ONLY_HIGH / BLOCK_MEDIUM_AND_ABOVE)
# GEMINI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE

# Gemini temperature untuk creative tasks (0.0 - 1.0)
# GEMINI_TEMPERATURE=0.3

# Grok temperature untuk draft generation (0.0 - 1.0)
# GROK_TEMPERATURE=0.7

# Max tokens untuk draft generation
# GROK_MAX_TOKENS=4096

# Max tokens untuk step Gemini (fact extraction, gap analysis, dll)
# GEMINI_MAX_TOKENS=2048

# Gemini output format (json_object memaksa valid JSON output)
# GEMINI_RESPONSE_FORMAT=json_object

# ------------------------------------------------------------
# NOTES
# ------------------------------------------------------------
# 1. Semua AI calls dilakukan dari backend — JANGAN masukkan API key ke frontend
# 2. Backend .env : duplikat file ini ke backend/.env dan isi nilainya
# 3. Frontend .env: duplikat file ini ke frontend/.env.local, hanya isi VITE_* vars
# 4. Jangan pernah commit backend/.env atau frontend/.env.local ke git
# 5. Untuk production, gunakan environment variable manager (Render, Railway, dll)
# 6. API Keys: GEMINI di https://aistudio.google.com/app/apikey
#              GROK   di https://console.x.ai/
